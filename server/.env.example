# real-estate-voice-agent - Environment Variables
# Copy this file to .env and fill in your API keys

# Twilio (Transport)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=


# Deepgram (STT/TTS)
DEEPGRAM_API_KEY=

# ElevenLabs (STT/TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google (STT/LLM/TTS/Realtime)
GOOGLE_API_KEY=
GOOGLE_MODEL=


